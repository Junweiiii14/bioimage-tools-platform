* text=auto eol=lf
*.pdf binary
*.png binary
*.jpg binary
*.tif binary
*.tiff binary
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve pinned upstream bytes for skill provenance on every checkout.
/.agents/skills/impeccable/scripts/impeccable.cmd text eol=lf

# Frozen evaluation outputs are byte-addressed evidence, including report self-references.
# Preserve the producer's bytes rather than normalizing generated JSON line endings.
/work/evidence/P-003/frozen-evaluation*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/work/evidence/P-003/scientific-request-report*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/work/evidence/P-006/frozen-runs/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/work/evidence/P-009/frozen-runs/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# P019 CSV/record and result evidence carry exact byte digests.
/tools/bca/examples/** -text
/work/evidence/P-019/results/** -text
/work/evidence/P-019/results-r1/** -text
