          "title": "Kind",
          "type": "string"
        },
        "sequence": {
          "const": 1,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "protocol_version",
        "run_id",
        "attempt_id",
        "request_id",
        "kind",
        "sequence"
      ],
      "title": "AcceptedFrame",
      "type": "object"
