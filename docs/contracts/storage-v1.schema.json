{
  "AssetRef": {
    "additionalProperties": false,
    "properties": {
      "asset_id": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "title": "Asset Id",
        "type": "string"
      },
      "relative_path": {
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9._/-]+$",
        "title": "Relative Path",
        "type": "string"
      },
      "schema_version": {
        "default": 1,
        "maximum": 1,
        "minimum": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Sha256",
        "type": "string"
      },
      "size_bytes": {
        "minimum": 0,
        "title": "Size Bytes",
        "type": "integer"
      }
    },
    "required": [
      "asset_id",
      "relative_path",
      "sha256",
      "size_bytes"
    ],
    "title": "AssetRef",
    "type": "object"
  },
  "DocumentRevision": {
    "additionalProperties": false,
    "properties": {
      "document_id": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "title": "Document Id",
        "type": "string"
      },
      "revision": {
        "minimum": 0,
        "title": "Revision",
        "type": "integer"
      },
      "tool_id": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "title": "Tool Id",
        "type": "string"
      }
    },
    "required": [
      "document_id",
      "tool_id",
      "revision"
    ],
    "title": "DocumentRevision",
    "type": "object"
  },
  "DraftSnapshot": {
    "$defs": {
      "AssetRef": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Asset Id",
            "type": "string"
          },
          "relative_path": {
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9._/-]+$",
            "title": "Relative Path",
            "type": "string"
          },
          "schema_version": {
            "default": 1,
            "maximum": 1,
            "minimum": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "asset_id",
          "relative_path",
          "sha256",
          "size_bytes"
        ],
        "title": "AssetRef",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "asset": {
        "$ref": "#/$defs/AssetRef"
      },
      "document_id": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "title": "Document Id",
        "type": "string"
      },
      "revision": {
        "minimum": 0,
        "title": "Revision",
        "type": "integer"
      },
      "tool_id": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "title": "Tool Id",
        "type": "string"
      }
    },
    "required": [
      "document_id",
      "tool_id",
      "revision",
      "asset"
    ],
    "title": "DraftSnapshot",
    "type": "object"
  },
  "ProcessExitReceipt": {
    "additionalProperties": false,
    "properties": {
      "exit_code": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Exit Code"
      },
      "pid": {
        "minimum": 0,
        "title": "Pid",
        "type": "integer"
      },
      "run_id": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "title": "Run Id",
        "type": "string"
      }
    },
    "required": [
      "run_id",
      "pid",
      "exit_code"
    ],
    "title": "ProcessExitReceipt",
    "type": "object"
  },
  "RecoveryReport": {
    "additionalProperties": false,
    "properties": {
      "interrupted_run_ids": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Interrupted Run Ids",
        "type": "array"
      },
      "orphan_paths": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Orphan Paths",
        "type": "array"
      },
      "quarantined_paths": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Quarantined Paths",
        "type": "array"
      }
    },
    "title": "RecoveryReport",
    "type": "object"
  },
  "RunRecord": {
    "$defs": {
      "AssetRef": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Asset Id",
            "type": "string"
          },
          "relative_path": {
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9._/-]+$",
            "title": "Relative Path",
            "type": "string"
          },
          "schema_version": {
            "default": 1,
            "maximum": 1,
            "minimum": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "asset_id",
          "relative_path",
          "sha256",
          "size_bytes"
        ],
        "title": "AssetRef",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "document_id": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "title": "Document Id",
        "type": "string"
      },
      "pid": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Pid"
      },
      "reason": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Reason"
      },
      "request": {
        "$ref": "#/$defs/AssetRef"
      },
      "result": {
        "anyOf": [
          {
            "$ref": "#/$defs/AssetRef"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "revision": {
        "minimum": 0,
        "title": "Revision",
        "type": "integer"
      },
      "run_id": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "title": "Run Id",
        "type": "string"
      },
      "state": {
        "enum": [
          "prepared",
          "running",
          "cancelling",
          "committing",
          "succeeded",
          "cancelled",
          "failed",
          "interrupted"
        ],
        "title": "State",
        "type": "string"
      },
      "tool_id": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "title": "Tool Id",
        "type": "string"
      }
    },
    "required": [
      "document_id",
      "tool_id",
      "revision",
      "run_id",
      "state",
      "request"
    ],
    "title": "RunRecord",
    "type": "object"
  },
  "WorkspaceFormat": {
    "additionalProperties": false,
    "properties": {
      "format": {
        "const": "bioimage-workspace",
        "title": "Format",
        "type": "string"
      },
      "version": {
        "maximum": 1,
        "minimum": 1,
        "title": "Version",
        "type": "integer"
      },
      "workspace_id": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "title": "Workspace Id",
        "type": "string"
      }
    },
    "required": [
      "format",
      "version",
      "workspace_id"
    ],
    "title": "WorkspaceFormat",
    "type": "object"
  }
}
