{
  "$defs": {
    "AnalysisRequest": {
      "additionalProperties": false,
      "properties": {
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "polarity": {
          "enum": [
            "dark",
            "light"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "lanes": {
          "items": {
            "$ref": "#/$defs/LaneAnnotation"
          },
          "title": "Lanes",
          "type": "array"
        },
        "geometry_policy": {
          "default": "fixed_grid@1",
          "enum": [
            "fixed_grid@1",
            "independent_lanes@1"
          ],
          "title": "Geometry Policy",
          "type": "string"
        },
        "quant_policy": {
          "default": "legacy_bounds@1",
          "enum": [
            "legacy_bounds@1",
            "wbquant_1_4_3@1",
            "background_support@1"
          ],
          "title": "Quant Policy",
          "type": "string"
        }
      },
      "required": [
        "source_sha256",
        "revision",
        "polarity",
        "lanes"
      ],
      "title": "AnalysisRequest",
      "type": "object"
    },
    "AnalysisResult": {
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/AnalysisRequest"
        },
        "bit_depth": {
          "title": "Bit Depth",
          "type": "integer"
        },
        "source_conversion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Conversion"
        },
        "lanes": {
          "items": {
            "$ref": "#/$defs/LaneAnalysis"
          },
          "title": "Lanes",
          "type": "array"
        },
        "algorithm_id": {
          "const": "profile_integral@1",
          "default": "profile_integral@1",
          "title": "Algorithm Id",
          "type": "string"
        },
        "quality_policy": {
          "default": "dtype_limits_review@1",
          "enum": [
            "dtype_limits_review@1",
            "background_support_review@1"
          ],
          "title": "Quality Policy",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "request",
        "bit_depth",
        "source_conversion",
        "lanes"
      ],
      "title": "AnalysisResult",
      "type": "object"
    },
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Asset Id",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9._/-]+$",
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "schema_version": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "relative_path",
        "sha256",
        "size_bytes"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "BandAnalysis": {
      "additionalProperties": false,
      "properties": {
        "annotation": {
          "$ref": "#/$defs/BandAnnotation"
        },
        "status": {
          "enum": [
            "valid",
            "quality_review",
            "invalid",
            "excluded",
            "not_detected"
          ],
          "title": "Status",
          "type": "string"
        },
        "measurement": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProfileMeasurement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "quality_flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        }
      },
      "required": [
        "annotation",
        "status"
      ],
      "title": "BandAnalysis",
      "type": "object"
    },
    "BandAnnotation": {
      "additionalProperties": false,
      "properties": {
        "band_id": {
          "title": "Band Id",
          "type": "string"
        },
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/BandBounds"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Baseline"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "included": {
          "default": true,
          "title": "Included",
          "type": "boolean"
        },
        "detection_notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Detection Notes",
          "type": "array"
        }
      },
      "required": [
        "band_id",
        "bounds"
      ],
      "title": "BandAnnotation",
      "type": "object"
    },
    "BandBounds": {
      "additionalProperties": false,
      "description": "Inclusive endpoints relative to the original, unsmoothed lane profile.",
      "properties": {
        "left": {
          "title": "Left",
          "type": "integer"
        },
        "right": {
          "title": "Right",
          "type": "integer"
        }
      },
      "required": [
        "left",
        "right"
      ],
      "title": "BandBounds",
      "type": "object"
    },
    "Baseline": {
      "additionalProperties": false,
      "description": "Endpoint intensities in the same polarity and units as the profile.",
      "properties": {
        "left_value": {
          "title": "Left Value",
          "type": "number"
        },
        "right_value": {
          "title": "Right Value",
          "type": "number"
        }
      },
      "required": [
        "left_value",
        "right_value"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "LaneAnalysis": {
      "additionalProperties": false,
      "properties": {
        "roi": {
          "$ref": "#/$defs/LaneROI"
        },
        "profiles": {
          "anyOf": [
            {
              "$ref": "#/$defs/LaneProfiles"
            },
            {
              "type": "null"
            }
          ]
        },
        "bands": {
          "items": {
            "$ref": "#/$defs/BandAnalysis"
          },
          "title": "Bands",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "roi",
        "profiles",
        "bands"
      ],
      "title": "LaneAnalysis",
      "type": "object"
    },
    "LaneAnnotation": {
      "additionalProperties": false,
      "properties": {
        "roi": {
          "$ref": "#/$defs/LaneROI"
        },
        "bands": {
          "items": {
            "$ref": "#/$defs/BandAnnotation"
          },
          "title": "Bands",
          "type": "array"
        }
      },
      "required": [
        "roi",
        "bands"
      ],
      "title": "LaneAnnotation",
      "type": "object"
    },
    "LaneProfiles": {
      "additionalProperties": false,
      "properties": {
        "roi": {
          "$ref": "#/$defs/LaneROI"
        },
        "raw": {
          "items": {
            "type": "number"
          },
          "title": "Raw",
          "type": "array"
        },
        "quantitative": {
          "items": {
            "type": "number"
          },
          "title": "Quantitative",
          "type": "array"
        },
        "polarity": {
          "enum": [
            "dark",
            "light"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "dtype_max": {
          "title": "Dtype Max",
          "type": "integer"
        }
      },
      "required": [
        "roi",
        "raw",
        "quantitative",
        "polarity",
        "dtype_max"
      ],
      "title": "LaneProfiles",
      "type": "object"
    },
    "LaneROI": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "title": "Lane Id",
          "type": "string"
        },
        "x0": {
          "title": "X0",
          "type": "integer"
        },
        "y0": {
          "title": "Y0",
          "type": "integer"
        },
        "x1": {
          "title": "X1",
          "type": "integer"
        },
        "y1": {
          "title": "Y1",
          "type": "integer"
        }
      },
      "required": [
        "lane_id",
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "LaneROI",
      "type": "object"
    },
    "MeasurementBinding": {
      "additionalProperties": false,
      "properties": {
        "figure_id": {
          "title": "Figure Id",
          "type": "string"
        },
        "row_id": {
          "title": "Row Id",
          "type": "string"
        },
        "column_id": {
          "title": "Column Id",
          "type": "string"
        },
        "lane_id": {
          "title": "Lane Id",
          "type": "string"
        },
        "band_id": {
          "title": "Band Id",
          "type": "string"
        }
      },
      "required": [
        "figure_id",
        "row_id",
        "column_id",
        "lane_id",
        "band_id"
      ],
      "title": "MeasurementBinding",
      "type": "object"
    },
    "OCRRecognition": {
      "additionalProperties": false,
      "properties": {
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "tokens": {
          "items": {
            "$ref": "#/$defs/TextToken"
          },
          "title": "Tokens",
          "type": "array"
        },
        "engine_id": {
          "title": "Engine Id",
          "type": "string"
        },
        "model_hashes": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Model Hashes",
          "type": "array"
        },
        "preprocess_id": {
          "default": "ocr_original_u8_or_u16_div257@1",
          "title": "Preprocess Id",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "source_sha256",
        "width",
        "height",
        "tokens",
        "engine_id",
        "model_hashes"
      ],
      "title": "OCRRecognition",
      "type": "object"
    },
    "ProfileMeasurement": {
      "additionalProperties": false,
      "properties": {
        "signal": {
          "title": "Signal",
          "type": "number"
        },
        "bounds": {
          "$ref": "#/$defs/BandBounds"
        },
        "baseline": {
          "$ref": "#/$defs/Baseline"
        },
        "baseline_source": {
          "enum": [
            "endpoints",
            "manual"
          ],
          "title": "Baseline Source",
          "type": "string"
        },
        "algorithm_id": {
          "const": "profile_integral@1",
          "default": "profile_integral@1",
          "title": "Algorithm Id",
          "type": "string"
        },
        "unit": {
          "const": "intensity*pixel",
          "default": "intensity*pixel",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "signal",
        "bounds",
        "baseline",
        "baseline_source"
      ],
      "title": "ProfileMeasurement",
      "type": "object"
    },
    "TextBounds": {
      "additionalProperties": false,
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "TextBounds",
      "type": "object"
    },
    "TextToken": {
      "additionalProperties": false,
      "properties": {
        "token_id": {
          "title": "Token Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/TextBounds"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "token_id",
        "text",
        "bounds",
        "confidence"
      ],
      "title": "TextToken",
      "type": "object"
    },
    "Worksheet": {
      "additionalProperties": false,
      "properties": {
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/WorksheetRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/WorksheetColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MeasurementBinding"
          },
          "title": "Bindings",
          "type": "array"
        },
        "layout_id": {
          "default": "explicit_fig_row_lane_binding@1",
          "title": "Layout Id",
          "type": "string"
        }
      },
      "required": [
        "source_sha256",
        "rows",
        "columns"
      ],
      "title": "Worksheet",
      "type": "object"
    },
    "WorksheetColumn": {
      "additionalProperties": false,
      "properties": {
        "column_id": {
          "title": "Column Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "column_id",
        "name"
      ],
      "title": "WorksheetColumn",
      "type": "object"
    },
    "WorksheetRow": {
      "additionalProperties": false,
      "properties": {
        "row_id": {
          "title": "Row Id",
          "type": "string"
        },
        "figure_id": {
          "title": "Figure Id",
          "type": "string"
        },
        "figure_name": {
          "title": "Figure Name",
          "type": "string"
        },
        "row_name": {
          "title": "Row Name",
          "type": "string"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "row_id",
        "figure_id",
        "figure_name",
        "row_name",
        "confirmed"
      ],
      "title": "WorksheetRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 2,
      "maximum": 2,
      "minimum": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/AssetRef"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "polarity": {
      "default": "dark",
      "enum": [
        "dark",
        "light"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "request": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recognition": {
      "anyOf": [
        {
          "$ref": "#/$defs/OCRRecognition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ocr_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssetRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "worksheet": {
      "anyOf": [
        {
          "$ref": "#/$defs/Worksheet"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "measurement": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "source",
    "revision"
  ],
  "title": "WBWorksheetDocument",
  "type": "object"
}
